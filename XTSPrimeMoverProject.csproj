<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Sub-projects live under these folders and are built separately. -->
  <ItemGroup>
    <Compile Remove="Core\**;tests\**;tools\**" />
    <EmbeddedResource Remove="Core\**;tests\**;tools\**" />
    <None Remove="Core\**;tests\**;tools\**" />
    <Page Remove="Core\**;tests\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <!-- Three.js digital twin served to WebView2 from the output folder. -->
  <ItemGroup>
    <Content Include="Web\twin\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\XTSPrimeMoverProject.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="HelixToolkit.Core.Wpf" Version="2.27.3" />
  </ItemGroup>

</Project>
